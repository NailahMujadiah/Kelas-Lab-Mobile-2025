<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:id="@+id/main"
    android:layout_height="680dp"
    android:gravity="center_horizontal"
    android:background="@color/black"
    android:orientation="vertical"
    tools:context=".MainDetailFeed">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="15dp"
        android:paddingBottom="6dp">

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/profile"
            android:layout_width="42dp"
            android:layout_marginLeft="10dp"
            android:layout_height="50dp"
            android:src="@drawable/mainprofile"
            app:civ_border_width="3dp"/>

        <TextView
            android:id="@+id/username"
            android:paddingLeft="10dp"
            android:paddingTop="14dp"
            android:layout_weight="1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="reinyourheart"
            android:textColor="@color/white"
            android:textSize="15sp"/>

        <ImageView
            android:layout_width="30dp"
            android:layout_height="40dp"
            android:paddingTop="15dp"
            android:layout_marginEnd="2dp"
            android:src="@drawable/threedots"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_margin="0dp">

        <ImageView
            android:id="@+id/postingan"
            android:layout_width="match_parent"
            android:layout_height="450dp"
            android:padding="0dp"
            android:scaleType="centerCrop"
            android:src="@drawable/feed3"
            />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="18dp"
                android:padding="2dp"
                android:src="@drawable/love"
                />

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="2dp"
                android:layout_marginStart="10dp"
                android:src="@drawable/comment40"/>

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="2dp"
                android:layout_marginStart="10dp"
                android:src="@drawable/plane4"/>

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="6dp"
                android:layout_gravity="end"
                android:layout_marginStart="190dp"
                android:src="@drawable/bookmark40"/>



        </LinearLayout>

        <TextView
            android:id="@+id/caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="10dp"
            android:paddingLeft="20dp"
            android:text="Caption"
            android:textSize="15sp"
            android:textColor="@color/white"/>

    </LinearLayout>


</LinearLayout>